# ─────────────────────────────────────────────────────────────────────
# FORENSIC AI — Environment Configuration
# Copy this file to .env and fill in at least ONE LLM provider.
# The platform auto-detects available providers in priority order:
#   Groq → OpenAI → Anthropic → Gemini → Together → OpenRouter
#   → LM Studio (local) → Ollama (local) → HuggingFace → Template
# ─────────────────────────────────────────────────────────────────────

# ── RECOMMENDED FREE OPTIONS FOR COLAB / FIRST-TIME SETUP ─────────────
# Groq: Ultra-fast inference, generous free tier, ideal for Colab
#   Sign up: https://console.groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini: Free tier with Gemini 1.5 Pro and 2.0 Flash
#   Get key: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PAID CLOUD PROVIDERS ───────────────────────────────────────────────
# OpenAI (GPT-4o / GPT-4o-mini)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude Opus / Haiku)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Together AI (hosted open-source, competitive pricing)
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (meta-router — access 100+ models with one key)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LOCAL PROVIDERS ────────────────────────────────────────────────────
# Ollama: https://ollama.com → ollama pull qwen2.5:7b
# (auto-detected at localhost:11434, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# LM Studio: https://lmstudio.ai → load any GGUF model
# (auto-detected at localhost:1234, no key needed)
# LMSTUDIO_BASE_URL=http://localhost:1234

# ── FORCE A SPECIFIC PROVIDER ──────────────────────────────────────────
# Override auto-detection and always use a specific provider:
# Options: auto | groq | openai | anthropic | gemini | together |
#          openrouter | lmstudio | ollama | hf
# LLM_PROVIDER=auto

# ── MODEL OVERRIDES (optional) ─────────────────────────────────────────
# Override the default model for any provider:
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-1.5-pro-latest
# GEMINI_FAST_MODEL=gemini-2.0-flash
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_FAST_MODEL=phi3.5:3.8b

# ── OUTPUT PATHS ───────────────────────────────────────────────────────
# Where to save investigation reports (default: ~/Documents/Forensic_Reports)
# REPORTS_DIR=/path/to/reports

# ── LOGGING ────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
