# ─────────────────────────────────────────────────────────────────────
# FORENSIC AI — Environment Configuration
# Agentic RAG Architecture: LangChain + LlamaIndex + LangGraph
#
# Copy this file to .env and fill in at least ONE LLM provider.
# All providers are equally supported — no "free-first" bias.
# DuckDuckGo internet search works with NO API key by default.
# ─────────────────────────────────────────────────────────────────────

# ── LLM PROVIDERS (set any one or more; platform auto-cascades) ────────

# OpenAI (GPT-4o / GPT-4o-mini)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude Sonnet / Haiku)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
# GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq — ultra-fast inference, generous free tier
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Together AI — hosted open-source models
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter — 100+ models with one key
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral AI
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere (Command-R / Command-R+)
# COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Bedrock
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Azure OpenAI
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── LOCAL PROVIDERS ────────────────────────────────────────────────────
# Ollama: https://ollama.com → ollama pull qwen2.5:7b
# (auto-detected at localhost:11434, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_FAST_MODEL=phi3.5:3.8b

# LM Studio: https://lmstudio.ai → load any GGUF model
# (auto-detected at localhost:1234, no key needed)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── PROVIDER SELECTION ─────────────────────────────────────────────────
# Force a specific provider or let the platform auto-cascade:
# Options: auto | openai | anthropic | google | groq | together |
#          openrouter | mistral | cohere | ollama | lmstudio | bedrock | azure | hf
# LLM_PROVIDER=auto

# ── MODEL OVERRIDES (optional per-provider) ────────────────────────────
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-1.5-pro-latest
# GEMINI_FAST_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# MISTRAL_MODEL=mistral-large-latest
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_FAST_MODEL=phi3.5:3.8b

# ── AGENTIC RAG SETTINGS ───────────────────────────────────────────────
# AGENTIC_RAG_ENABLED=true       # Enable LangGraph pipeline (default: true)
# AGENTIC_RAG_MAX_ITER=3         # Max rewrite-retrieve-generate cycles
# LLAMAINDEX_ENABLED=true        # Use LlamaIndex for vector retrieval
# INTERNET_SEARCH_ENABLED=true   # Enable open internet search
# TOOLS_API_ENABLED=true         # Enable live financial data via yfinance
# SEARCH_PROVIDER=duckduckgo     # tavily | duckduckgo | serper | serpapi

# ── INTERNET SEARCH API KEYS (optional — DuckDuckGo works without) ─────
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SERPAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OUTPUT PATHS ───────────────────────────────────────────────────────
# REPORTS_DIR=/path/to/reports

# ── LOGGING ────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
